# Public Firebase client identifiers. They identify the project, not admin credentials.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Backend ONLY: set securely in GitHub Actions repository secrets.
# FOOTBALL_DATA_TOKEN=
# SPORTAPI_KEY= # backend only: live results, 2000/day and 14000/month on Free
# FIREBASE_SERVICE_ACCOUNT=
# FIREBASE_PROJECT_ID=  # only required with deliberately configured ADC
# ESPN_MATCH_DETAILS=false # optional: disable complementary public ESPN data (no key)
# ESPN_NEWS=false # optional repository variable: disable ESPN headlines (no key)
