rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed() { return request.auth != null; }
  function member(gid) { return signed() && request.auth.uid in get(/databases/$(database)/documents/groups/$(gid)).data.memberIds; }
  function owner(gid) { return signed() && get(/databases/$(database)/documents/groups/$(gid)).data.ownerId == request.auth.uid; }
  function onlyMemberChange(before, after) { return after.diff(before).affectedKeys().hasOnly(['memberIds']); }
  // Informational pot per player and round, in cents. The app never handles money.
  function validPot(data) { return !('potCents' in data) || (data.potCents is int && data.potCents >= 0 && data.potCents <= 100000); }
  match /users/{uid} {
   allow read: if signed();
   allow create, update: if signed() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['name','avatar','updatedAt']) && request.resource.data.name is string && request.resource.data.name.size() <= 100 && (request.resource.data.avatar == null || request.resource.data.avatar is string) && request.resource.data.updatedAt == request.time;
   allow delete: if signed() && request.auth.uid == uid;
   // One push subscription per browser (id = SHA-256 of its endpoint). Only the
   // player reads or changes theirs; the backend sends to browser push services only.
   match /push/{device} {
    allow get, list, delete: if signed() && request.auth.uid == uid;
    allow create, update: if signed() && request.auth.uid == uid && device.matches('^[a-f0-9]{64}$')
      && request.resource.data.keys().hasOnly(['endpoint','p256dh','auth','createdAt'])
      && request.resource.data.endpoint is string && request.resource.data.endpoint.size() <= 1000
      && request.resource.data.endpoint.matches('https://(web[.]push[.]apple[.]com|fcm[.]googleapis[.]com|updates[.]push[.]services[.]mozilla[.]com|[a-z0-9-]+[.]notify[.]windows[.]com)/.+')
      && request.resource.data.p256dh is string && request.resource.data.p256dh.size() >= 40 && request.resource.data.p256dh.size() <= 200
      && request.resource.data.auth is string && request.resource.data.auth.size() >= 10 && request.resource.data.auth.size() <= 100
      && request.resource.data.createdAt == request.time;
   }
  }
  // Public half of the push signing keys; the private half has no client rule.
  match /config/push { allow get: if true; }
  match /competitions/{id} { allow read: if true; }
  match /seasons/{id} { allow read: if true; }
  match /rounds/{id} { allow read: if true; }
  match /matches/{id} { allow read: if true; }
  // Public season snapshots reduce calendar reads; clients still cannot write results.
  match /calendars/{id} { allow read: if true; }
  // Complementary public match details, fetched only when a fixture is opened.
  match /teamDirectory/featured { allow get: if true; }
  match /news/football { allow get: if true; }
  match /leagueStats/{id} { allow get: if id.matches('^(PD|CL|PL)-[0-9]{4}$'); }
  match /matchInsights/{id} { allow get: if true; }
  // Single public live board (scores, minute, goals and cards); backend writes only.
  match /live/football { allow get: if true; }
  // Informational 1X2 prices from public bookmakers; backend writes only.
  match /odds/football { allow get: if true; }
  // The AI's betting analysis of each match day (information only); backend writes only.
  match /analysis/football { allow get: if true; }
  // «La IA te cuenta» on Inicio: key matches and stories chosen by the AI; backend writes only.
  match /briefing/football { allow get: if true; }
  // Slips of «IA» and «Favorito», frozen before each round closes; backend writes only.
  match /machinePicks/{id} { allow get: if id.matches('^(PD|CL|PL)-[0-9]{4}$'); }
  // Competitions between friends. The document id is the invitation code:
  // whoever has it can follow the competition (read only, even without an
  // account). Signed players follow it; the owner and the administrators run it.
  match /customCompetitions/{cid} {
   function competition() { return getAfter(/databases/$(database)/documents/customCompetitions/$(cid)).data; }
   function owns(c) { return signed() && c.ownerId == request.auth.uid; }
   function runs(c) { return signed() && (c.ownerId == request.auth.uid || request.auth.uid in c.adminIds); }
   function text(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
   function picture(v, max) { return v == null || (v is string && v.size() <= max && v.matches('data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/=]+')); }
   function validCompetition(d) {
    return text(d.name, 3, 60) && text(d.sport, 0, 40) && picture(d.icon, 60000)
      && d.participantType in ['team','person']
      && d.format in ['league','knockout','league_knockout','groups_knockout','custom']
      && d.legs in [1,2] && d.knockoutLegs in [1,2]
      && d.qualifiers is int && d.qualifiers >= 0 && d.qualifiers <= 16
      && d.groups is int && d.groups >= 0 && d.groups <= 8
      && d.thirdPlace is bool && d.predictionMode in ['exact','classic','off']
      && d.schedule is map && d.schedule.keys().hasOnly(['start','time','everyDays','slotMinutes','location','timeZone'])
      && d.schedule.start is string && d.schedule.start.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
      && d.schedule.time is string && d.schedule.time.matches('([01][0-9]|2[0-3]):[0-5][0-9]')
      && d.schedule.everyDays is int && d.schedule.everyDays >= 1 && d.schedule.everyDays <= 28
      && d.schedule.slotMinutes is int && d.schedule.slotMinutes >= 0 && d.schedule.slotMinutes <= 240
      && text(d.schedule.location, 0, 120) && text(d.schedule.timeZone, 1, 60)
      && d.adminIds is list && d.adminIds.size() <= 20 && d.memberIds is list && d.memberIds.size() <= 500
      && d.adminIds.toSet().difference(d.memberIds.toSet()).size() == 0
      && d.ownerId in d.memberIds
      // Private unless the owner makes it public; the words it is searched by.
      && d.get('visibility', 'private') in ['public','private']
      && d.get('searchTerms', []) is list && d.get('searchTerms', []).size() <= 120;
   }
   // Anyone with the link or the code opens it; only public ones can be searched.
   allow get: if true;
   allow list: if signed() && (request.auth.uid in resource.data.memberIds || resource.data.visibility == 'public');
   // The short code is written in the same batch: competitionCodes/{code} -> this id.
   function codeFor(code) {
    return code is string && code.matches('[A-HJKMNP-Z2-9]{6}')
      && getAfter(/databases/$(database)/documents/competitionCodes/$(code)).data.competitionId == cid;
   }
   allow create: if signed()
     && request.resource.data.keys().hasOnly(['name','sport','icon','participantType','format','legs','knockoutLegs','qualifiers','groups','thirdPlace','predictionMode','schedule','ownerId','adminIds','memberIds','formatVersion','createdAt','updatedAt','code','visibility','searchTerms'])
     && (!('code' in request.resource.data) || codeFor(request.resource.data.code))
     && request.resource.data.ownerId == request.auth.uid
     && request.resource.data.memberIds == [request.auth.uid] && request.resource.data.adminIds == []
     && request.resource.data.formatVersion == 1
     && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
     && validCompetition(request.resource.data);
   allow update: if signed() && (
     // Owner: name, sport, icon, prediction mode, visibility and who administers.
     (owns(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','sport','icon','adminIds','predictionMode','visibility','searchTerms','updatedAt'])
       && request.resource.data.updatedAt == request.time && validCompetition(request.resource.data))
     // Owner: give a competition from before short codes its code, once.
     || (owns(resource.data) && !('code' in resource.data)
       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['code'])
       && codeFor(request.resource.data.code))
     // Follow with the code: add only yourself.
     || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
       && !(request.auth.uid in resource.data.memberIds)
       && request.resource.data.memberIds.toSet() == resource.data.memberIds.toSet().union([request.auth.uid].toSet())
       && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
       && request.resource.data.memberIds.size() <= 500)
     // Unfollow: remove only yourself (an administrator also stops being one).
     || (request.auth.uid in resource.data.memberIds && resource.data.ownerId != request.auth.uid
       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds','adminIds'])
       && request.resource.data.memberIds.toSet() == resource.data.memberIds.toSet().difference([request.auth.uid].toSet())
       && request.resource.data.adminIds.toSet() == resource.data.adminIds.toSet().difference([request.auth.uid].toSet()))
   );
   // The app deletes matches and participants first, then the competition.
   allow delete: if owns(resource.data);
   match /participants/{pid} {
    allow read: if true;
    // A team's squad travels with it (each player is checked by the app).
    allow create, update: if runs(competition()) && pid.matches('[A-Za-z0-9_-]{1,40}')
      && request.resource.data.keys().hasOnly(['name','kind','userId','icon','seed','players'])
      && request.resource.data.get('players', []) is list && request.resource.data.get('players', []).size() <= 60
      && text(request.resource.data.name, 1, 40) && request.resource.data.kind in ['team','person']
      && (request.resource.data.userId == null || text(request.resource.data.userId, 1, 128))
      && picture(request.resource.data.icon, 30000)
      && request.resource.data.seed is int && request.resource.data.seed >= 0 && request.resource.data.seed < 64;
    allow delete: if runs(competition());
   }
   match /matches/{mid} {
    function goals(v) { return v == null || (v is int && v >= 0 && v <= 99); }
    function side(id, slot) {
     return (id == null || text(id, 1, 40))
       && (slot == null || (slot is string && slot.matches('league:[0-9]{1,2}|group:[A-H]:[1-8]|(winner|loser):[A-Z0-9]{1,4}')))
       && (id != null || slot != null);
    }
    function validMatch(d) {
     return d.keys().hasOnly(['phase','round','stage','group','tie','leg','homeId','awayId','homeSlot','awaySlot','startAt','location','status','homeScore','awayScore','homePenalties','awayPenalties','locked','events','lineups','updatedAt','updatedBy'])
       // The report: goals, cards and changes, and both lineups.
       && d.get('events', []) is list && d.get('events', []).size() <= 150
       && d.get('lineups', {}) is map && d.get('lineups', {}).keys().hasOnly(['home','away'])
       && d.get('lineups', {}).get('home', []) is list && d.get('lineups', {}).get('home', []).size() <= 40
       && d.get('lineups', {}).get('away', []) is list && d.get('lineups', {}).get('away', []).size() <= 40
       && d.phase in ['league','group','knockout','custom']
       && d.round is int && d.round >= 1 && d.round <= 300
       && d.stage in ['REGULAR_SEASON','GROUP_STAGE','LAST_32','LAST_16','QUARTER_FINALS','SEMI_FINALS','THIRD_PLACE','FINAL']
       && (d.group == null || (d.group is string && d.group.matches('[A-H]')))
       && (d.tie == null || (d.tie is string && d.tie.matches('[A-Z0-9]{1,4}')))
       && (d.leg == null || d.leg in [1,2])
       && side(d.homeId, d.homeSlot) && side(d.awayId, d.awaySlot)
       && (d.homeId == null || d.homeId != d.awayId)
       && d.startAt is timestamp && text(d.location, 0, 120)
       && d.status in ['scheduled','live','finished','postponed','cancelled']
       && goals(d.homeScore) && goals(d.awayScore) && goals(d.homePenalties) && goals(d.awayPenalties)
       && (d.status in ['live','finished'] || (d.homeScore == null && d.awayScore == null))
       && (d.status != 'finished' || (d.homeScore != null && d.awayScore != null))
       && ((d.homePenalties == null) == (d.awayPenalties == null))
       && (d.homePenalties == null || (d.status == 'finished' && d.phase == 'knockout' && d.homePenalties != d.awayPenalties))
       && d.locked is bool && (d.locked == false || d.status in ['finished','cancelled'])
       && d.updatedAt == request.time && d.updatedBy == request.auth.uid;
    }
    allow read: if true;
    allow create: if runs(competition()) && mid.matches('[A-Za-z0-9_-]{1,40}')
      && validMatch(request.resource.data) && request.resource.data.locked == false;
    // A confirmed (locked) result only changes, or unlocks, with the owner.
    allow update: if runs(competition()) && validMatch(request.resource.data)
      && (resource.data.locked != true || owns(competition()));
    allow delete: if runs(competition())
      && (owns(competition()) || (resource.data.locked != true && resource.data.status != 'finished'));
    // Followers' drafts: only your own, only before kick-off. Drafts never
    // leak, not even after kick-off: only sealed slips (rounds/…/entries) count.
    match /picks/{uid} {
     function fixture() { return get(/databases/$(database)/documents/customCompetitions/$(cid)/matches/$(mid)).data; }
     function league() { return get(/databases/$(database)/documents/customCompetitions/$(cid)).data; }
     function open() { return fixture().status == 'scheduled' && request.time < fixture().startAt; }
     function validPick(d) {
      return d.keys().hasOnly(['value','updatedAt']) && d.updatedAt == request.time && d.value is string
        && ((league().predictionMode == 'classic' && d.value in ['1','X','2'])
          || (league().predictionMode == 'exact' && d.value.matches('[0-9]{1,2}-[0-9]{1,2}')));
     }
     allow get: if signed() && request.auth.uid == uid;
     allow create, update: if signed() && request.auth.uid == uid && request.auth.uid in league().memberIds
       && open() && validPick(request.resource.data);
     allow delete: if signed() && request.auth.uid == uid && open();
    }
   }
   // The quiniela's rounds, as in LaLiga: closing time (first kick-off) and the
   // matches a slip must cover. The organisers' app keeps them in step.
   match /rounds/{rk} {
    allow read: if true;
    // A closed round never reopens: its slips were sealed against it.
    allow create, update: if runs(competition()) && rk.matches('[A-Za-z0-9_]{1,20}')
      && (resource == null || resource.data.deadline > request.time)
      && request.resource.data.keys().hasOnly(['deadline','matchIds','updatedAt'])
      && request.resource.data.deadline is timestamp
      && request.resource.data.matchIds is list && request.resource.data.matchIds.size() >= 1
      && request.resource.data.matchIds.size() <= 64
      && request.resource.data.updatedAt == request.time;
    allow delete: if runs(competition());
    // A sealed slip: complete, before the deadline, never changed. Readable by
    // whoever has sealed theirs, and by everyone once the round has closed.
    match /entries/{uid} {
     function round() { return get(/databases/$(database)/documents/customCompetitions/$(cid)/rounds/$(rk)).data; }
     function sealed(u) { return exists(/databases/$(database)/documents/customCompetitions/$(cid)/rounds/$(rk)/entries/$(u)); }
     function selectionsOk(selections, ids, mode) {
      return selections is string && ids is list && ids.size() > 0 && ids.size() <= 64 && selections.size() <= 383
        && ((mode == 'classic' && selections.matches('^[1X2]{' + string(ids.size()) + '}$'))
        || (mode == 'exact' && selections.matches('^[0-9]{1,2}:[0-9]{1,2}(,[0-9]{1,2}:[0-9]{1,2}){' + string(ids.size()-1) + '}$')));
     }
     allow get: if signed() && (request.auth.uid == uid || sealed(request.auth.uid) || request.time >= round().deadline);
     allow list: if signed() && (sealed(request.auth.uid) || request.time >= round().deadline);
     allow create: if signed() && request.auth.uid == uid && request.auth.uid in competition().memberIds
       && request.resource.data.keys().hasOnly(['userId','matchIds','selections','mode','submittedAt'])
       && request.resource.data.userId == uid && request.resource.data.submittedAt == request.time
       && request.time < round().deadline
       && request.resource.data.matchIds == round().matchIds
       && request.resource.data.mode == competition().predictionMode
       && selectionsOk(request.resource.data.selections, request.resource.data.matchIds, request.resource.data.mode)
       && getAfter(/databases/$(database)/documents/customCompetitions/$(cid)/roundAttendance/$(rk)).data.members[uid] == request.time;
    }
   }
   // Who has sealed each round (never what), for «faltan por sellar».
   match /roundAttendance/{rk} {
    allow read: if true;
    function validAttendance() {
     return signed() && request.resource.data.keys().hasOnly(['members']) && request.resource.data.members is map
       && request.resource.data.members[request.auth.uid] == request.time
       && getAfter(/databases/$(database)/documents/customCompetitions/$(cid)/rounds/$(rk)/entries/$(request.auth.uid)).data.submittedAt == request.time;
    }
    allow create: if validAttendance() && request.resource.data.members.keys().hasOnly([request.auth.uid]);
    allow update: if validAttendance() && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid]);
   }
  }
  // Short invitation codes. Readable one by one (never listed); only the owner
  // of the competition it points to creates it, and it never changes.
  match /competitionCodes/{code} {
   function target(id) { return /databases/$(database)/documents/customCompetitions/$(id); }
   allow get: if true;
   allow create: if signed() && code.matches('[A-HJKMNP-Z2-9]{6}')
     && request.resource.data.keys().hasOnly(['competitionId','createdAt'])
     && request.resource.data.createdAt == request.time
     && request.resource.data.competitionId is string
     && getAfter(target(request.resource.data.competitionId)).data.ownerId == request.auth.uid
     && getAfter(target(request.resource.data.competitionId)).data.code == code;
   // Together with the competition, by its owner.
   allow delete: if signed() && !existsAfter(target(resource.data.competitionId))
     && get(target(resource.data.competitionId)).data.ownerId == request.auth.uid;
  }
  match /groups/{gid} {
   // A high-entropy document ID is an invitation capability. Lists remain member-only.
   allow get: if signed();
   allow list: if signed() && request.auth.uid in resource.data.memberIds;
   allow create: if signed() && request.resource.data.keys().hasOnly(['name','ownerId','memberIds','createdAt','potCents']) && validPot(request.resource.data) && request.resource.data.ownerId == request.auth.uid && request.resource.data.memberIds == [request.auth.uid] && getAfter(/databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid)).data.userId == request.auth.uid && request.resource.data.name is string && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 60 && request.resource.data.createdAt == request.time;
   allow update: if signed() && (
    (owner(gid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','potCents']) && validPot(request.resource.data) && request.resource.data.name is string && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 60)
    || (onlyMemberChange(resource.data,request.resource.data) && request.resource.data.memberIds is list && request.resource.data.memberIds.size() <= 30 && (
      (!(request.auth.uid in resource.data.memberIds) && request.resource.data.memberIds.toSet() == resource.data.memberIds.toSet().union([request.auth.uid].toSet()) && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1 && getAfter(/databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid)).data.userId == request.auth.uid)
      || (request.auth.uid in resource.data.memberIds && resource.data.ownerId != request.auth.uid && request.resource.data.memberIds.toSet() == resource.data.memberIds.toSet().difference([request.auth.uid].toSet()) && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1 && !existsAfter(/databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid)))
    ))
   );
   match /members/{uid} {
    allow read: if member(gid);
    allow create: if signed() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['userId','joinedAt']) && request.resource.data.userId == uid && request.resource.data.joinedAt == request.time && uid in getAfter(/databases/$(database)/documents/groups/$(gid)).data.memberIds;
    allow delete: if signed() && request.auth.uid == uid && !(uid in getAfter(/databases/$(database)/documents/groups/$(gid)).data.memberIds);
   }
   match /gameSeasons/{sid} {
    allow read: if member(gid);
    allow create: if signed() && getAfter(/databases/$(database)/documents/groups/$(gid)).data.ownerId == request.auth.uid && request.resource.data.keys().hasOnly(['competition','seasonId','mode','createdAt']) && request.resource.data.competition in ['PD','CL','PL'] && request.resource.data.seasonId == sid && request.resource.data.mode in ['classic','exact'] && request.resource.data.createdAt == request.time;
    // No client updates: mode and season remain immutable, even for the owner.
    function marker(uid, rid) { return /databases/$(database)/documents/groups/$(gid)/gameSeasons/$(sid)/submissions/$(uid)/rounds/$(rid); }
    function entry(uid, rid) { return /databases/$(database)/documents/groups/$(gid)/gameSeasons/$(sid)/roundEntries/$(rid)/players/$(uid); }
    function attendance(rid) { return /databases/$(database)/documents/groups/$(gid)/gameSeasons/$(sid)/roundAttendance/$(rid); }
    function exact(v) { return v is map && v.keys().hasOnly(['home','away']) && v.home is int && v.away is int && v.home >= 0 && v.away >= 0 && v.home <= 99 && v.away <= 99; }
    function complete(selections, ids, mode) {
     return selections is string && ids is list && ids.size() > 0 && ids.size() <= 64 && selections.size() <= 383
       && ((mode == 'classic' && selections.matches('^[1X2]{' + string(ids.size()) + '}$'))
       || (mode == 'exact' && selections.matches('^[0-9]{1,2}:[0-9]{1,2}(,[0-9]{1,2}:[0-9]{1,2}){' + string(ids.size()-1) + '}$')));
    }
    match /submissions/{uid}/rounds/{rid} {
     allow read: if member(gid) && request.auth.uid == uid;
     allow create: if member(gid) && request.auth.uid == uid
       && request.resource.data.keys().hasOnly(['userId','roundId','submittedAt','formatVersion'])
       && request.resource.data.userId == uid && request.resource.data.roundId == rid && request.resource.data.formatVersion == 2
       && request.resource.data.submittedAt == request.time
       && getAfter(entry(uid,rid)).data.submittedAt == request.time
       && getAfter(attendance(rid)).data.members[uid] == request.time;
     // Immutable marker, complete snapshot and attendance are committed together.
    }
    match /roundEntries/{rid}/players/{uid} {
     allow read: if member(gid) && uid in get(/databases/$(database)/documents/groups/$(gid)).data.memberIds && (request.auth.uid == uid || exists(entry(request.auth.uid,rid)));
     allow create: if member(gid) && request.auth.uid == uid
       && request.resource.data.keys().hasOnly(['userId','roundId','submittedAt','formatVersion','mode','matchIds','selections'])
       && request.resource.data.userId == uid && request.resource.data.roundId == rid && request.resource.data.formatVersion == 2
       && request.resource.data.submittedAt == request.time
       && get(/databases/$(database)/documents/rounds/$(rid)).data.seasonId == sid
       && request.time < get(/databases/$(database)/documents/rounds/$(rid)).data.submissionDeadline
       && request.resource.data.matchIds == get(/databases/$(database)/documents/rounds/$(rid)).data.requiredMatchIds
       && request.resource.data.mode == get(/databases/$(database)/documents/groups/$(gid)/gameSeasons/$(sid)).data.mode
       && complete(request.resource.data.selections, request.resource.data.matchIds, request.resource.data.mode)
       && getAfter(marker(uid,rid)).data.submittedAt == request.time
       && getAfter(marker(uid,rid)).data.formatVersion == 2
       && getAfter(attendance(rid)).data.members[uid] == request.time;
    }
    match /roundAttendance/{rid} {
     allow read: if member(gid);
     function validAttendance() {
      return member(gid) && request.resource.data.keys().hasOnly(['members']) && request.resource.data.members is map
        && request.resource.data.members[request.auth.uid] == request.time
        && getAfter(entry(request.auth.uid,rid)).data.submittedAt == request.time;
     }
     allow create: if validAttendance() && request.resource.data.members.keys().hasOnly([request.auth.uid]);
     allow update: if validAttendance() && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid]);
    }
    match /predictions/{pid} {
     function fixture() { return get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data; }
     function game() { return get(/databases/$(database)/documents/groups/$(gid)/gameSeasons/$(sid)).data; }
     function own() { return signed() && request.resource.data.userId == request.auth.uid && pid == request.auth.uid + '_' + request.resource.data.matchId; }
     // Drafts never leak, including after kickoff. Sharing uses complete snapshots only.
     allow read: if member(gid) && resource.data.userId == request.auth.uid;
     function validWrite() { return member(gid) && own() && request.resource.data.keys().hasOnly(['userId','matchId','roundId','value','updatedAt']) && request.resource.data.updatedAt == request.time && fixture().seasonId == sid && fixture().competition == game().competition && fixture().roundId == request.resource.data.roundId && !exists(/databases/$(database)/documents/groups/$(gid)/gameSeasons/$(sid)/submissions/$(request.auth.uid)/rounds/$(request.resource.data.roundId)) && request.time < get(/databases/$(database)/documents/rounds/$(request.resource.data.roundId)).data.submissionDeadline && request.time < fixture().kickoffAt && fixture().status in ['TIMED','SCHEDULED'] && ((game().mode == 'classic' && request.resource.data.value in ['1','X','2']) || (game().mode == 'exact' && exact(request.resource.data.value))); }
     allow create: if validWrite();
     allow update: if validWrite() && request.resource.data.roundId == resource.data.roundId;
    }
    match /standings/{uid} { allow read: if member(gid); }
   }
  }
 }
}
